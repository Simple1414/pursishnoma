{
  "name": "researchsurvey-frontend",
  "private": true,
  "description": "Build tooling for ResearchSurvey CSS/JS. Output is committed to static/ so production needs no Node.js.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/app.css -o ../static/css/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/app.css -o ../static/css/app.css --watch",
    "vendor": "node vendor.js",
    "build": "npm run vendor && npm run build:css"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource/source-serif-4": "5.2.9",
    "alpinejs": "3.15.0",
    "chart.js": "4.5.1",
    "tailwindcss": "3.4.19",
    "@tailwindcss/forms": "0.5.10"
  }
}
