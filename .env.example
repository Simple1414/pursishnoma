# Copy to .env and fill in. Never commit .env.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=survey.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://survey.example.org
PUBLIC_BASE_URL=https://survey.example.org
DJANGO_USE_HTTPS=true
DJANGO_LANGUAGE_CODE=tg
DJANGO_TIME_ZONE=Asia/Dushanbe

# PostgreSQL (required — SQLite is not supported)
DATABASE_URL=postgres://researchsurvey:CHANGE_ME@localhost:5432/researchsurvey
DB_SSL_REQUIRE=false

# First administrator (created by `manage.py ensure_admin` if missing)
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=change-me-strong-password
DJANGO_ADMIN_EMAIL=

# Rate limits "<count>/<seconds>"
RATE_LIMIT_LOGIN=10/900
RATE_LIMIT_START=20/600
RATE_LIMIT_SUBMIT=60/600

# Optional AI research assistant (Anthropic Claude). Leave AI_PROVIDER=none to disable.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=4000
