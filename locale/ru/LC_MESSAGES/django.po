#: analytics/intelligence.py:37
#, python-format
msgid "Most frequent answer — question %(n)s"
msgstr "Наиболее частый ответ — вопрос %(n)s"

#: analytics/intelligence.py:38
#, python-format
msgid ""
"For “%(q)s”, the most frequent answer was “%(o)s”: %(c)s of %(n)s "
"respondents (%(p)s%%)."
msgstr ""
"На вопрос «%(q)s» чаще всего отвечали «%(o)s»: %(c)s из %(n)s респондентов "
"(%(p)s%%)."

#: analytics/intelligence.py:49
#, python-format
msgid "Most selected options — question %(n)s"
msgstr "Наиболее выбираемые варианты — вопрос %(n)s"

#: analytics/intelligence.py:50
#, python-format
msgid ""
"For “%(q)s” (multiple answers, n = %(n)s), the most selected options were: "
"%(p)s."
msgstr ""
"В вопросе «%(q)s» (несколько ответов, n = %(n)s) чаще всего выбирали: %(p)s."

#: analytics/intelligence.py:63
#, python-format
msgid "High missing rate — question %(n)s"
msgstr "Высокая доля пропусков — вопрос %(n)s"

#: analytics/intelligence.py:64
#, python-format
msgid ""
"Question “%(q)s” was not answered by %(m)s of %(N)s respondents (%(p)s%%); "
"interpret its results with caution."
msgstr ""
"На вопрос «%(q)s» не ответили %(m)s из %(N)s респондентов (%(p)s%%); "
"интерпретируйте результаты с осторожностью."

#: analytics/intelligence.py:72
msgid "Highest-rated statement"
msgstr "Утверждение с наивысшей оценкой"

#: analytics/intelligence.py:73
msgid "Lowest-rated statement"
msgstr "Утверждение с наименьшей оценкой"

#: analytics/intelligence.py:78
#, python-format
msgid ""
"“%(q)s”: mean %(m)s (SD %(sd)s, n = %(n)s); %(a)s respondents (%(p)s%%) "
"chose one of the two highest scale points."
msgstr ""
"«%(q)s»: среднее %(m)s (СО %(sd)s, n = %(n)s); %(a)s респондентов (%(p)s%%) "
"выбрали одну из двух высших точек шкалы."

#: analytics/intelligence.py:96
#, python-format
msgid ""
"%(s)s: mean %(m)s (SD %(sd)s, median %(md)s, n = %(n)s) on the original "
"response scale."
msgstr ""
"%(s)s: среднее %(m)s (СО %(sd)s, медиана %(md)s, n = %(n)s) по исходной "
"шкале ответов."

#: analytics/intelligence.py:106
msgid "Possible straight-lining"
msgstr "Возможные однотипные ответы (straight-lining)"

#: analytics/intelligence.py:107
#, python-format
msgid ""
"%(k)s responses gave the identical answer to every Likert item of at least "
"one section (≥5 items). Review them before analysis."
msgstr ""
"%(k)s ответов дали одинаковую оценку всем пунктам Лайкерта хотя бы в одном "
"разделе (≥5 пунктов). Проверьте их перед анализом."

#: analytics/intelligence.py:128
#, python-format
msgid "Recurring theme — question %(n)s"
msgstr "Повторяющаяся тема — вопрос %(n)s"

#: analytics/intelligence.py:129
#, python-format
msgid ""
"%(k)s of %(n)s answers to “%(q)s” are similar and share the terms: %(t)s."
msgstr ""
"%(k)s из %(n)s ответов на вопрос «%(q)s» схожи и содержат общие термины: "
"%(t)s."

#: analytics/intelligence.py:166
