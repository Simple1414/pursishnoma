#: analytics/stats.py:103 analytics/stats.py:132
#, python-format
msgid "Section mean: %(t)s"
msgstr "Миёнаи қисм: %(t)s"

#: analytics/stats.py:196
msgid "respondents who answered (multiple answers possible)"
msgstr "респондентони ҷавобдода (якчанд ҷавоб имконпазир аст)"

#: analytics/stats.py:196
msgid "valid answers"
msgstr "ҷавобҳои эътибордор"

#: analytics/stats.py:260
msgid "Mean rank (lower = more important)"
msgstr "Рутбаи миёна (камтар = муҳимтар)"

#: analytics/stats.py:288
msgid "No respondents answered both questions."
msgstr "Ҳеҷ респондент ба ҳарду савол ҷавоб надодааст."

#: analytics/stats.py:314
msgid "A test needs at least a 2×2 table."
msgstr "Барои санҷиш ақаллан ҷадвали 2×2 лозим аст."

#: analytics/stats.py:319
msgid "Pearson chi-square test of independence"
msgstr "Санҷиши χ²-и Пирсон барои мустақилият"

#: analytics/stats.py:334
#, python-format
msgid ""
"More than 20%% of cells have expected counts below 5; the chi-square "
"approximation may be unreliable."
msgstr ""
"Дар зиёда аз 20%% катакҳо басомади интизорӣ аз 5 камтар аст; наздикшавии χ² "
"метавонад боэътимод набошад."

#: analytics/stats.py:357 analytics/stats.py:435 reports/renderers.py:213
#: reports/renderers.py:287 templates/analytics/compare.html:19
#: templates/analytics/compare.html:39 templates/analytics/overview.html:36
msgid "Mean"
msgstr "Миёна"

#: analytics/stats.py:360
msgid "At least two groups with data are needed."
msgstr "Ақаллан ду гурӯҳи дорои маълумот лозим аст."

#: analytics/stats.py:366
#, python-format
msgid ""
"Not tested: groups with fewer than %(n)s respondents (%(g)s). Descriptive "
"results only."
msgstr ""
"Санҷиш гузаронида нашуд: гурӯҳҳое, ки камтар аз %(n)s респондент доранд "
"(%(g)s). Танҳо натиҷаҳои тавсифӣ."

#: analytics/stats.py:372
msgid "All values are identical; no test is meaningful."
msgstr "Ҳамаи қиматҳо якхелаанд; санҷиш маъно надорад."

#: analytics/stats.py:379
msgid "Mann–Whitney U test (two-sided)"
msgstr "Санҷиши U-и Манн–Уитни (дутарафа)"

#: analytics/stats.py:383
msgid "rank-biserial correlation"
msgstr "коррелятсияи рутбавӣ-бисериалӣ"

#: analytics/stats.py:393
msgid "Kruskal–Wallis H test"
msgstr "Санҷиши H-и Краскел–Уоллис"

#: analytics/stats.py:398
msgid "epsilon squared"
msgstr "эпсилон-квадрат"

#: analytics/stats.py:412
msgid "At least 3 paired, non-constant observations are needed."
msgstr "Ақаллан 3 мушоҳидаи ҷуфт ва тағйирёбанда лозим аст."

#: analytics/stats.py:417
msgid "Spearman rank correlation"
msgstr "Коррелятсияи рутбавии Спирман"

