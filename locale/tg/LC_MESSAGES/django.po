msgid "title"
msgstr "сарлавҳа"

#: analytics/models.py:28 surveys/models.py:235
#: templates/surveys/detail.html:64
msgid "text"
msgstr "матн"

#: analytics/models.py:48
msgid "Explain statistical results"
msgstr "Шарҳи натиҷаҳои оморӣ"

#: analytics/models.py:49
msgid "Summarize responses"
msgstr "Хулосаи ҷавобҳо"

#: analytics/models.py:50
msgid "Identify possible patterns"
msgstr "Муайян кардани қонуниятҳои эҳтимолӣ"

#: analytics/models.py:51
