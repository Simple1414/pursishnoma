#: analytics/ai.py:114
msgid "The AI assistant is not configured (set AI_PROVIDER and AI_API_KEY)."
msgstr ""
"Ёрдамчии AI танзим нашудааст (AI_PROVIDER ва AI_API_KEY-ро муқаррар кунед)."

#: analytics/ai.py:118
msgid "There are no completed responses to analyse."
msgstr "Барои таҳлил ҷавобҳои пурра вуҷуд надоранд."

#: analytics/ai.py:133
msgid "The anthropic package is not installed."
msgstr "Бастаи anthropic насб нашудааст."

#: analytics/ai.py:161
msgid "The AI provider rejected the API key."
msgstr "Провайдери AI калиди API-ро рад кард."

#: analytics/ai.py:163
msgid "The AI provider rate limit was reached. Try again later."
msgstr "Ҳадди дархостҳои провайдери AI ба охир расид. Баъдтар такрор кунед."

#: analytics/ai.py:166
msgid "The AI provider rejected the request."
msgstr "Провайдери AI дархостро рад кард."

#: analytics/ai.py:169
msgid "The AI provider returned an error. Try again later."
msgstr "Провайдери AI хато баргардонд. Баъдтар такрор кунед."

#: analytics/ai.py:171
msgid "The AI provider could not be reached."
msgstr "Бо провайдери AI пайваст шудан ғайриимкон аст."

#: analytics/ai.py:174
msgid "The AI provider declined this request."
msgstr "Провайдери AI аз иҷрои ин дархост даст кашид."

#: analytics/ai.py:177
msgid "The AI provider returned an empty answer."
msgstr "Провайдери AI ҷавоби холӣ баргардонд."

#: analytics/ai.py:179
msgid "Output truncated at the configured token limit."
msgstr "Матн дар ҳадди муқарраршудаи токенҳо бурида шуд."

#: analytics/intelligence.py:37
#, python-format
msgid "Most frequent answer — question %(n)s"
msgstr "Ҷавоби бештар такроршаванда — саволи %(n)s"

#: analytics/intelligence.py:38
#, python-format
msgid ""
"For “%(q)s”, the most frequent answer was “%(o)s”: %(c)s of %(n)s "
"respondents (%(p)s%%)."
msgstr ""
"Дар саволи «%(q)s» ҷавоби бештар интихобшуда «%(o)s» буд: %(c)s аз %(n)s "
"респондент (%(p)s%%)."

#: analytics/intelligence.py:49
#, python-format
msgid "Most selected options — question %(n)s"
msgstr "Вариантҳои бештар интихобшуда — саволи %(n)s"

#: analytics/intelligence.py:50
#, python-format
msgid ""
"For “%(q)s” (multiple answers, n = %(n)s), the most selected options were: "
"%(p)s."
msgstr ""
"Дар саволи «%(q)s» (якчанд ҷавоб, n = %(n)s) вариантҳои бештар интихобшуда: "
"%(p)s."

#: analytics/intelligence.py:63
#, python-format
msgid "High missing rate — question %(n)s"
msgstr "Ҳиссаи баланди ҷавобҳои холӣ — саволи %(n)s"

#: analytics/intelligence.py:64
#, python-format
msgid ""
"Question “%(q)s” was not answered by %(m)s of %(N)s respondents (%(p)s%%); "
"interpret its results with caution."
msgstr ""
"Ба саволи «%(q)s» %(m)s аз %(N)s респондент ҷавоб надодаанд (%(p)s%%); "
"натиҷаҳои онро бо эҳтиёт шарҳ диҳед."

#: analytics/intelligence.py:72
msgid "Highest-rated statement"
msgstr "Изҳороти баландтарин баҳододашуда"

#: analytics/intelligence.py:73
msgid "Lowest-rated statement"
msgstr "Изҳороти пасттарин баҳододашуда"

#: analytics/intelligence.py:78
#, python-format
msgid ""
"“%(q)s”: mean %(m)s (SD %(sd)s, n = %(n)s); %(a)s respondents (%(p)s%%) "
"chose one of the two highest scale points."
msgstr ""
"«%(q)s»: миёна %(m)s (ИС %(sd)s, n = %(n)s); %(a)s респондент (%(p)s%%) яке "
"аз ду дараҷаи болоии миқёсро интихоб кардаанд."

#: analytics/intelligence.py:96
#, python-format
msgid ""
"%(s)s: mean %(m)s (SD %(sd)s, median %(md)s, n = %(n)s) on the original "
"response scale."
msgstr ""
"%(s)s: миёна %(m)s (ИС %(sd)s, медиана %(md)s, n = %(n)s) дар миқёси аслии "
"ҷавобҳо."

#: analytics/intelligence.py:106
msgid "Possible straight-lining"
msgstr "Эҳтимоли ҷавобҳои якранг (straight-lining)"

#: analytics/intelligence.py:107
#, python-format
msgid ""
"%(k)s responses gave the identical answer to every Likert item of at least "
"one section (≥5 items). Review them before analysis."
msgstr ""
"%(k)s ҷавоб ба ҳамаи изҳороти Ликерти ақаллан як қисм (≥5 изҳорот) баҳои "
"якхела додаанд. Пеш аз таҳлил онҳоро санҷед."

#: analytics/intelligence.py:128
#, python-format
msgid "Recurring theme — question %(n)s"
msgstr "Мавзӯи такроршаванда — саволи %(n)s"

#: analytics/intelligence.py:129
#, python-format
msgid ""
"%(k)s of %(n)s answers to “%(q)s” are similar and share the terms: %(t)s."
msgstr ""
"%(k)s аз %(n)s ҷавоб ба саволи «%(q)s» ба ҳам монанданд ва истилоҳҳои умумӣ "
"доранд: %(t)s."

#: analytics/intelligence.py:166
msgid "Draft generated from approved findings — review before use."
msgstr ""
"Тарҳ аз бозёфтҳои тасдиқшуда тартиб дода шуд — пеш аз истифода санҷед."

#: analytics/models.py:12
msgid "Draft — not reviewed"
msgstr "Тарҳ — санҷида нашудааст"

#: analytics/models.py:13
msgid "Approved by researcher"
msgstr "Аз ҷониби муҳаққиқ тасдиқ шудааст"

#: analytics/models.py:14
msgid "Rejected"
msgstr "Рад шудааст"

#: analytics/models.py:21 templates/analytics/intelligence.html:24
msgid "Statistical result"
msgstr "Натиҷаи оморӣ"

#: analytics/models.py:22 templates/analytics/assistant.html:25
msgid "AI-generated interpretation"
msgstr "Шарҳи тавлидкардаи AI"

